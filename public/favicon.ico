<svg width="512" height="512" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background Dark Rounded Square -->
  <rect width="512" height="512" rx="128" fill="#080C14"/>
  <rect x="8" y="8" width="496" height="496" rx="120" stroke="url(#borderGlow)" stroke-width="6"/>
  
  <!-- Subtle Ambient Glow -->
  <circle cx="256" cy="256" r="180" fill="url(#radialGlow)" opacity="0.4"/>
  
  <!-- Shield Outline -->
  <path d="M256 58L106 125V230C106 327.5 170.5 414.5 256 440C341.5 414.5 406 327.5 406 230V125L256 58Z" 
        stroke="url(#shieldStroke)" stroke-width="18" stroke-linejoin="round" fill="rgba(16, 185, 129, 0.08)"/>

  <!-- Compass Star / North Star Motif -->
  <path d="M256 120L278 214L372 236L278 258L256 352L234 258L140 236L234 214L256 120Z" 
        fill="url(#starGradient)" stroke="#080C14" stroke-width="4"/>

  <!-- Center Diamond & Core Dot -->
  <circle cx="256" cy="236" r="18" fill="#FFFFFF"/>
  <circle cx="256" cy="236" r="8" fill="#10B981"/>

  <!-- Cardinal Points Indicators -->
  <circle cx="256" cy="88" r="7" fill="#10B981"/>
  <circle cx="424" cy="236" r="7" fill="#06B6D4"/>
  <circle cx="256" cy="410" r="7" fill="#10B981"/>
  <circle cx="88" cy="236" r="7" fill="#06B6D4"/>

  <defs>
    <radialGradient id="radialGlow" cx="0.5" cy="0.5" r="0.5" fx="0.5" fy="0.5">
      <stop offset="0%" stop-color="#10B981" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#080C14" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="borderGlow" x1="0" y1="0" x2="512" y2="512" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#10B981" stop-opacity="0.8"/>
      <stop offset="50%" stop-color="#06B6D4" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#10B981" stop-opacity="0.8"/>
    </linearGradient>
    <linearGradient id="shieldStroke" x1="106" y1="58" x2="406" y2="440" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="50%" stop-color="#06B6D4"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <linearGradient id="starGradient" x1="140" y1="120" x2="372" y2="352" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="50%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#06B6D4"/>
    </linearGradient>
  </defs>
</svg>
